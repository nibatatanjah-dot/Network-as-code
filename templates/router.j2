! P3 NETWORK-AS-CODE REFERENCE SNAPSHOT — generated; not a drop-in full running-config.
! Reconcile with the sanitized P1 running-config before making a deployable candidate.
! CI uses synthetic IPsec keys only. Never deploy --mode ci output.
hostname {{ site.router }}
no ip domain-lookup
ip cef
service timestamps debug datetime msec
service timestamps log datetime msec
!
interface {{ site.wan.interface }}
 description WAN-to-ISP
 ip address {{ site.wan.address }} {{ site.wan.mask }}
 ip nat outside
 no shutdown
 crypto map P3-VPN
!
interface {{ site.lan_trunk_interface }}
 description 802.1Q-trunk-to-{{ site.switch }}
 no ip address
 no shutdown
!
{% for vlan in vlans if vlan.id in [10, 20, 30, 99] %}
interface {{ site.lan_trunk_interface }}.{{ vlan.id }}
 description VLAN-{{ vlan.id }}-{{ vlan.name }}
 encapsulation dot1Q {{ vlan.id }}
 ip address 10.{{ site.site_id }}.{{ vlan.id }}.1 255.255.255.0
 ip nat inside
{% if vlan.id == 10 %} ip access-group STAFF-IN in
{% elif vlan.id == 20 %} ip access-group SERVERS-IN in
{% elif vlan.id == 30 %} ip access-group GUEST-IN in
{% elif vlan.id == 99 %} ip access-group MGMT-IN in
{% endif %} no shutdown
!
{% endfor %}
{% for tunnel in site.tunnels %}
interface {{ tunnel.interface }}
 description GRE-to-{{ tunnel.remote_router }}-protected-by-IPsec
 ip address {{ tunnel.local_address }} {{ tunnel.local_mask }}
 ip ospf network point-to-point
 tunnel source {{ site.wan.interface }}
 tunnel destination {{ tunnel.remote_wan_address }}
 tunnel mode gre ip
 no shutdown
!
{% endfor %}
interface Loopback0
 description OSPF-router-id
 ip address {{ site.router_id }} 255.255.255.255
!
! DHCP: Staff and Guest only. Management and servers use reserved/static addresses.
ip dhcp excluded-address 10.{{ site.site_id }}.10.1 10.{{ site.site_id }}.10.99
ip dhcp excluded-address 10.{{ site.site_id }}.10.201 10.{{ site.site_id }}.10.254
ip dhcp excluded-address 10.{{ site.site_id }}.30.1 10.{{ site.site_id }}.30.99
ip dhcp excluded-address 10.{{ site.site_id }}.30.201 10.{{ site.site_id }}.30.254
ip dhcp pool {{ site.key | upper }}-STAFF
 network 10.{{ site.site_id }}.10.0 255.255.255.0
 default-router 10.{{ site.site_id }}.10.1
 dns-server {{ simulated_internet_ip }}
!
ip dhcp pool {{ site.key | upper }}-GUEST
 network 10.{{ site.site_id }}.30.0 255.255.255.0
 default-router 10.{{ site.site_id }}.30.1
 dns-server {{ simulated_internet_ip }}
!
! NAT applies to this site's inside prefixes. Remote-site traffic exits the GRE tunnel.
ip access-list standard NAT-INSIDE
 permit 10.{{ site.site_id }}.0.0 0.0.255.255
!
ip nat inside source list NAT-INSIDE interface {{ site.wan.interface }} overload
ip route 0.0.0.0 0.0.0.0 {{ site.wan.next_hop }}
!
! Staff can use approved HQ services and basic internet protocols; other internal access is denied.
ip access-list extended STAFF-IN
 permit udp any eq 68 any eq 67
 permit icmp any host 10.{{ site.site_id }}.10.1
 permit tcp any host {{ test_server_ip }} eq www
 permit tcp any host {{ test_server_ip }} eq 443
 permit tcp any host {{ test_server_ip }} eq 445
 permit udp any host {{ test_server_ip }} eq domain
 permit tcp any host {{ test_server_ip }} eq domain
{% for other in sites %}
 deny ip any 10.{{ other.site_id }}.30.0 0.0.0.255 log
{% endfor %}
{% for other in sites %}
 deny ip any 10.{{ other.site_id }}.99.0 0.0.0.255 log
{% endfor %}
 deny ip any 10.0.0.0 0.255.255.255 log
 permit tcp any any eq www
 permit tcp any any eq 443
 permit udp any any eq domain
 permit tcp any any eq domain
 deny ip any any log
!
! Guests may use HTTP/HTTPS/DNS and DHCP but may not access internal 10/8 addresses.
ip access-list extended GUEST-IN
 permit udp any eq 68 any eq 67
 deny ip any 10.0.0.0 0.255.255.255 log
 permit tcp any any eq www
 permit tcp any any eq 443
 permit udp any any eq domain
 permit tcp any any eq domain
 deny ip any any log
!
! Server-originated flows are limited to established internal responses and update services.
ip access-list extended SERVERS-IN
{% if site.server_attached %}
 permit tcp host {{ test_server_ip }} 10.0.0.0 0.255.255.255 established
 permit udp host {{ test_server_ip }} eq domain 10.0.0.0 0.255.255.255 gt 1023
 permit tcp host {{ test_server_ip }} any eq www
 permit tcp host {{ test_server_ip }} any eq 443
 permit udp host {{ test_server_ip }} any eq domain
 permit tcp host {{ test_server_ip }} any eq domain
{% endif %}
 deny ip any any log
!
! Management may use SSH/HTTPS/ICMP only toward internal site prefixes.
ip access-list extended MGMT-IN
{% for src in sites %}
{% for dst in sites %}
 permit icmp 10.{{ src.site_id }}.99.0 0.0.0.255 10.{{ dst.site_id }}.0.0 0.0.255.255
 permit tcp 10.{{ src.site_id }}.99.0 0.0.0.255 10.{{ dst.site_id }}.0.0 0.0.255.255 eq 22
 permit tcp 10.{{ src.site_id }}.99.0 0.0.0.255 10.{{ dst.site_id }}.0.0 0.0.255.255 eq 443
{% endfor %}
{% endfor %}
 deny ip any any log
!
{% for tunnel in site.tunnels %}
ip access-list extended {{ tunnel.crypto_acl }}
 permit gre host {{ site.wan.address }} host {{ tunnel.remote_wan_address }}
!
{% endfor %}
crypto isakmp policy 10
 encr aes
 authentication pre-share
 group 2
 lifetime 86400
!
crypto ipsec transform-set P3-TS esp-aes esp-sha-hmac
 mode transport
!
{% for tunnel in site.tunnels %}
crypto isakmp key {{ vpn_keys[tunnel.key_environment_variable] }} address {{ tunnel.remote_wan_address }}
crypto map P3-VPN {{ tunnel.crypto_sequence }} ipsec-isakmp
 set peer {{ tunnel.remote_wan_address }}
 set transform-set P3-TS
 match address {{ tunnel.crypto_acl }}
!
{% endfor %}
router ospf {{ ospf_process_id }}
 router-id {{ site.router_id }}
 passive-interface default
{% for tunnel in site.tunnels %}
 no passive-interface {{ tunnel.interface }}
{% endfor %}
 network 10.{{ site.site_id }}.0.0 0.0.255.255 area 0
 network 10.255.0.0 0.0.0.255 area 0
{% for tunnel in site.tunnels %}
 network {{ tunnel.network_address }} {{ tunnel.wildcard_mask }} area 0
{% endfor %}
!
line con 0
 logging synchronous
line vty 0 4
 transport input ssh
!
end
