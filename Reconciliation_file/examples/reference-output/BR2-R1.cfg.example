! P3 NETWORK-AS-CODE REFERENCE SNAPSHOT — generated; not a drop-in full running-config.
! Reconcile with the sanitized P1 running-config before making a deployable candidate.
! CI uses synthetic IPsec keys only. Never deploy --mode ci output.
hostname BR2-R1
no ip domain-lookup
ip cef
service timestamps debug datetime msec
service timestamps log datetime msec
!
interface GigabitEthernet0/0
 description WAN-to-ISP
 ip address 192.0.2.2 255.255.255.252
 ip nat outside
 no shutdown
 crypto map P3-VPN
!
interface GigabitEthernet0/1
 description 802.1Q-trunk-to-BR2-SW1
 no ip address
 no shutdown
!
interface GigabitEthernet0/1.10
 description VLAN-10-STAFF
 encapsulation dot1Q 10
 ip address 10.30.10.1 255.255.255.0
 ip nat inside
 ip access-group STAFF-IN in
 no shutdown
!
interface GigabitEthernet0/1.20
 description VLAN-20-SERVERS
 encapsulation dot1Q 20
 ip address 10.30.20.1 255.255.255.0
 ip nat inside
 ip access-group SERVERS-IN in
 no shutdown
!
interface GigabitEthernet0/1.30
 description VLAN-30-GUESTS
 encapsulation dot1Q 30
 ip address 10.30.30.1 255.255.255.0
 ip nat inside
 ip access-group GUEST-IN in
 no shutdown
!
interface GigabitEthernet0/1.99
 description VLAN-99-MGMT
 encapsulation dot1Q 99
 ip address 10.30.99.1 255.255.255.0
 ip access-group MGMT-IN in
 no shutdown
!
interface Tunnel1
 description GRE-to-HQ-R1-protected-by-IPsec
 ip address 172.16.0.6 255.255.255.252
 ip ospf network point-to-point
 tunnel source GigabitEthernet0/0
 tunnel destination 203.0.113.2
 tunnel mode gre ip
 no shutdown
!
interface Loopback0
 description OSPF-router-id
 ip address 10.255.0.3 255.255.255.255
!
! DHCP: Staff and Guest only. Management and servers use reserved/static addresses.
ip dhcp excluded-address 10.30.10.1 10.30.10.99
ip dhcp excluded-address 10.30.10.201 10.30.10.254
ip dhcp excluded-address 10.30.30.1 10.30.30.99
ip dhcp excluded-address 10.30.30.201 10.30.30.254
ip dhcp pool STAFF
 network 10.30.10.0 255.255.255.0
 default-router 10.30.10.1
 dns-server 8.8.8.8
!
ip dhcp pool GUESTS
 network 10.30.30.0 255.255.255.0
 default-router 10.30.30.1
 dns-server 8.8.8.8
!
! NAT applies to this site's inside prefixes. Remote-site traffic exits the GRE tunnel.
ip access-list standard NAT-LIST
 permit 10.30.10.0 0.0.0.255
 permit 10.30.20.0 0.0.0.255
 permit 10.30.30.0 0.0.0.255
!
ip nat inside source list NAT-LIST interface GigabitEthernet0/0 overload
ip route 0.0.0.0 0.0.0.0 192.0.2.1
!
! Staff can use approved HQ services and basic internet protocols; other internal access is denied.
ip access-list extended STAFF-IN
 permit udp any eq 68 any eq 67
 permit icmp any host 10.30.10.1
 permit tcp any host 10.10.20.10 eq www
 permit tcp any host 10.10.20.10 eq 443
 permit tcp any host 10.10.20.10 eq 445
 permit udp any host 10.10.20.10 eq domain
 permit tcp any host 10.10.20.10 eq domain
 deny ip any 10.10.30.0 0.0.0.255 log
 deny ip any 10.20.30.0 0.0.0.255 log
 deny ip any 10.30.30.0 0.0.0.255 log
 deny ip any 10.10.99.0 0.0.0.255 log
 deny ip any 10.20.99.0 0.0.0.255 log
 deny ip any 10.30.99.0 0.0.0.255 log
 deny ip any 10.0.0.0 0.255.255.255 log
 permit tcp any any eq www
 permit tcp any any eq 443
 permit udp any any eq domain
 permit tcp any any eq domain
 deny ip any any log
!
! Guests may use HTTP/HTTPS/DNS and DHCP but may not access internal 10/8 addresses.
ip access-list extended GUEST-IN
 permit udp any eq 68 any eq 67
 deny ip any 10.0.0.0 0.255.255.255 log
 permit tcp any any eq www
 permit tcp any any eq 443
 permit udp any any eq domain
 permit tcp any any eq domain
 deny ip any any log
!
! Server-originated flows are limited to established internal responses and update services.
ip access-list extended SERVERS-IN
 deny ip any any log
!
! Management may use SSH/HTTPS/ICMP only toward internal site prefixes.
ip access-list extended MGMT-IN
 permit icmp 10.10.99.0 0.0.0.255 10.10.0.0 0.0.255.255
 permit tcp 10.10.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 22
 permit tcp 10.10.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 443
 permit icmp 10.10.99.0 0.0.0.255 10.20.0.0 0.0.255.255
 permit tcp 10.10.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 22
 permit tcp 10.10.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 443
 permit icmp 10.10.99.0 0.0.0.255 10.30.0.0 0.0.255.255
 permit tcp 10.10.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 22
 permit tcp 10.10.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 443
 permit icmp 10.20.99.0 0.0.0.255 10.10.0.0 0.0.255.255
 permit tcp 10.20.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 22
 permit tcp 10.20.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 443
 permit icmp 10.20.99.0 0.0.0.255 10.20.0.0 0.0.255.255
 permit tcp 10.20.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 22
 permit tcp 10.20.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 443
 permit icmp 10.20.99.0 0.0.0.255 10.30.0.0 0.0.255.255
 permit tcp 10.20.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 22
 permit tcp 10.20.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 443
 permit icmp 10.30.99.0 0.0.0.255 10.10.0.0 0.0.255.255
 permit tcp 10.30.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 22
 permit tcp 10.30.99.0 0.0.0.255 10.10.0.0 0.0.255.255 eq 443
 permit icmp 10.30.99.0 0.0.0.255 10.20.0.0 0.0.255.255
 permit tcp 10.30.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 22
 permit tcp 10.30.99.0 0.0.0.255 10.20.0.0 0.0.255.255 eq 443
 permit icmp 10.30.99.0 0.0.0.255 10.30.0.0 0.0.255.255
 permit tcp 10.30.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 22
 permit tcp 10.30.99.0 0.0.0.255 10.30.0.0 0.0.255.255 eq 443
 deny ip any any log
!
ip access-list extended VPN-GRE-BR2-HQ
 permit gre host 192.0.2.2 host 203.0.113.2
!
crypto isakmp policy 10
 encr aes
 authentication pre-share
 group 2
 lifetime 86400
!
crypto ipsec transform-set P3-TS esp-aes esp-sha-hmac
 mode transport
!
crypto isakmp key P3_CI_ONLY_NOT_A_REAL_SECRET_HQ_BR2 address 203.0.113.2
crypto map P3-VPN 10 ipsec-isakmp
 set peer 203.0.113.2
 set transform-set P3-TS
 match address VPN-GRE-BR2-HQ
!
router ospf 1
 router-id 10.255.0.3
 passive-interface default
 no passive-interface Tunnel1
 network 10.30.0.0 0.0.255.255 area 0
 network 10.255.0.0 0.0.0.255 area 0
 network 172.16.0.4 0.0.0.3 area 0
!
line con 0
 logging synchronous
line vty 0 4
 transport input ssh
!
end
